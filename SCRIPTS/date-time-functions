SELECT 
3.516,
ROUND(3.516,2) AS round_2,
ROUND(3.516,1) AS round_1,
ROUND(3.516,0) AS round_0

SELECT
-10,
ABS(-10) abs_

SELECT
OrderID,
'2026-09-01'  day,
GETDATE()
FROM Sales.Orders

SELECT
OrderID,
CreationTime,
YEAR(CreationTime) as year,
DATEPART(YEAR,CreationTime) as year_pt,
MONTH(CreationTime) as month,
DATEPART(HOUR,CreationTime) as hour_pt,
DATEPART(quarter,CreationTime) as Quarter_pt,
DATEPART(weekday,CreationTime) as Weekday_pt,
DATEPART(week,CreationTime) as week_pt,
DAY(CreationTime) as day
FROM Sales.Orders

SELECT
 OrderID,
 CreationTime,
 ----datename examples
 DATENAME(month,CreationTime) as month_name,
 DATENAME(weekday,CreationTime) as weekday_dn,
 DATENAME(day,CreationTime) as day_dn,
 ----datetrunc examples
 DATETRUNC(minute,CreationTime) as min_dtr,
 DATETRUNC(day,CreationTime) as day_dtr,
 DATETRUNC(year,CreationTime) as year_dtr
FROM Sales.Orders

---using datetrunc
SELECT
  DATETRUNC(month,CreationTime) as Creation,
  COUNT(*)
  FROM Sales.Orders
  GROUP BY DATETRUNC(month,CreationTime)
use cases
use SalesDB
SELECT
  OrderID,
  CreationTime,
  EOMONTH(CreationTime) AS End_month,
  CAST(DATETRUNC(MONTH,CreationTime) AS DATE)AS Start_of_month
FROM Sales.Orders
----how many orders were placed each year
SELECT
  year(OrderDate) OrderDate,
  COUNT(*) AS NrOfOrders
FROM Sales.Orders
GROUP BY year(OrderDate)

----how many orders were placed each month

SELECT
  DATENAME(month,OrderDate) as OrderMonth,
  COUNT(*) nooforders
FROM Sales.Orders
GROUP BY DATENAME(MONTH,OrderDate)

---Show all orders that were placed in the month of february
SELECT
   DATENAME(MONTH,OrderDate) as OrderDate,
   OrderID
FROM Sales.Orders
WHERE MONTH(OrderDate) = 2
use SalesDB
SELECT
  OrderID,
  CreationTime,
  FORMAT(CreationTime,'MM-dd-yyyy') NCT,
  FORMAT(CreationTime,'dd-MMM-yyyy') EU_NCT,
  FORMAT(CreationTime,'dd') dd,
  FORMAT(CreationTime, 'ddd') as day,
  FORMAT(CreationTime, 'dddd') as dddd,
    FORMAT(CreationTime,'MM') MM,
  FORMAT(CreationTime, 'MMM') as Month,
  FORMAT(CreationTime, 'MMMM') as MMMM
FROM Sales.Orders

---Show CreationTime using the following format:
----Day Wed Jan Q1 2025 12:34:56 PM

SELECT
    OrderID,
    CreationTime,
    'Day ' + FORMAT(CreationTime,'ddd MMM') + 
    ' Q' + DATENAME(quarter,CreationTime) +' '+
    FORMAT(CreationTime, 'yyyy hh:mm:ss tt') as CustomerFormat
FROM Sales.Orders 

---USE CASE

SELECT 
    FORMAT(OrderDate,'MMM yy') as OrderDate,
    COUNT(*)
FROM Sales.Orders
GROUP BY FORMAT(OrderDate,'MMM yy')


SELECT 
  CONVERT(INT,'123') AS [String to Int CONVERT],
  CONVERT(DATE, '2025-01-13') AS [String to DATE CONVERT],
  CreationTime,
  CONVERT(DATE,CreationTime) AS [Datetime to Date Convert]
FROM Sales.Orders

SELECT
    CreationTime,
    CONVERT(DATE,CreationTime) AS [Datetime to Date CONVERT],
    CONVERT(VARCHAR,CreationTime,32) AS [USA Std. Style: 32],
    CONVERT(VARCHAR,CreationTime,34) AS [EUR Std. Style: 34]
FROM Sales.Orders

---CAST

SELECT
  CAST('123' AS INT) AS [String to INT],
  CAST(123 AS VARCHAR) AS [INT to String],
  CAST('2026-3-01' AS DATE) AS [String to Date],
   CAST('2026-3-01' AS DATETIME2) AS [String to Datetime2],
   CreationTime,
   CAST(CreationTime AS DATE) AS [Creationtime date]
FROM Sales.Orders


----DATEADD examples
SELECT 
  OrderID,
  OrderDate,
  DATEADD(day,-10,OrderDate) TenDaysEarly,
  DATEADD(month,3,OrderDate) ThreeMonthsLater,
  DATEADD(year,2,OrderDate) twoyearslater
FROM Sales.Orders;

---calculate the age of employees
SELECT
 EmployeeID,
 BirthDate,
 DATEDIFF(year,BirthDate,GETDATE())  Age
 FROM Sales.Employees;

 ---find the average shipping duration in days for each month
 SELECT
   MONTH(OrderDate) OrderDate,
    AVG(DATEDIFF(day,OrderDate,ShipDate)) AvgShipDuration
 FROM Sales.Orders
 GROUP BY MONTH(OrderDate);

 -----or as follows

  SELECT
   DATENAME(month,OrderDate) OrderDate,
    AVG(DATEDIFF(day,OrderDate,ShipDate)) AvgShipDuration
 FROM Sales.Orders
 GROUP BY  DATENAME(month,OrderDate)

 ---find the number of days between each order and the previous orders
 SELECT
    OrderID,
    OrderDate CurrentOrderDate,
    LAG(OrderDate) OVER (ORDER BY OrderDate) PreviousOrderDate,
    DATEDIFF(day,LAG(OrderDate) OVER (ORDER BY OrderDate),OrderDate) NrOfDays
FROM Sales.Orders;

SELECT 
  ISDATE('123') date_check1,
  ISDATE('2025-08-20') date_check2,
  ISDATE('20-08-2025') date_check3

